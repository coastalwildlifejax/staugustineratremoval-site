// Cloudflare Worker (static assets in public/). Deployed by .github/workflows/deploy.yml on every push to main.
{
  "name": "staugustineratremoval-site-2",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "staugustineratremoval.com", "custom_domain": true },
    { "pattern": "www.staugustineratremoval.com", "custom_domain": true }
  ]
}
